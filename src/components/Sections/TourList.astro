---
import { getCollection } from "astro:content";
import Card from "../UI/Card.astro";
import Button from "../UI/Button.astro";
import { priceLabel, byOrder } from "../../utils/price";

export interface Props {
  count?: number;
  showViewAll?: boolean;
}

const { count = 6, showViewAll = true } = Astro.props;

const allTours = await getCollection("tours", ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const tours = allTours.sort(byOrder).slice(0, count);
---

<section class="section-y">
  <div class="container">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Private tours</h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        From Prague Castle to the Velvet Revolution, on the streets where it happened.
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {tours.map((tour) => {
        return (
        <Card
          class="shadow-none"
          title={tour.data.shortTitle ?? tour.data.title}
          image={{
            src: tour.data.image || "/images/tour-placeholder.webp",
            alt: tour.data.title
          }}
          href={`/tours/${tour.slug}/`}
        >
          <div class="mb-3 flex items-center text-gray-600">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>{tour.data.duration}</span>
          </div>

          <div class="mb-3 flex items-center text-gray-600">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
            </svg>
            <span>{priceLabel(tour.data)}</span>
          </div>

          <p class="text-gray-700 mb-4">{tour.data.summary}</p>

          <p class="text-primary-600 font-medium group-hover:underline group-hover:text-primary-700">
            More information →
          </p>
          
        </Card>
        );
      })}
    </div>
    
    {showViewAll && tours.length > 0 && (
      <div class="mt-12 text-center">
        <Button href="/tours/" variant="outline">
          Compare all tours
        </Button>
      </div>
    )}
  </div>
</section>
