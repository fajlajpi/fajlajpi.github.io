---
import { site, fullAddress, phoneHref } from "../../config/site";

// Footer navigation groups with trailing slashes
const footerNavs = [
  {
    title: "Navigation",
    items: [
      { text: "Tours", href: "/tours/" },
      { text: "About", href: "/about/" },
      { text: "FAQ", href: "/faq/" },
      { text: "Contact", href: "/contact/" },
    ],
  },
];

const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 text-white pt-16 pb-8">
  <div class="container">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8 mb-12 md:max-w-2xl md:mx-auto lg:max-w-2xl">
      <!-- Contact Info -->
      <div>
        <div class="mb-4">
          <a href="/" class="text-2xl font-bold text-white font-serif inline-flex items-center">
            <img src="/uploads/bluefox-white.png" alt="" width="960" height="540" class="h-12 w-auto mr-2">
            <span>{site.name}</span>
          </a>
        </div>

        <address class="not-italic mb-4 text-gray-300">
          <p>{site.guide}</p>
          <p class="mt-2">
            <a href={phoneHref} class="hover:text-primary-300">
              {site.phone}
            </a>
          </p>
          <p>
            <a href={`mailto:${site.email}`} class="hover:text-primary-300">
              {site.email}
            </a>
          </p>
        </address>
      </div>

      <!-- Navigation Links -->
      {
        footerNavs.map((group) => (
          <div>
            <h4 class="text-lg font-bold mb-4 text-white">{group.title}</h4>
            <ul class="space-y-2">
              {group.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="text-gray-300 hover:text-primary-300 transition-colors"
                  >
                    {item.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- Copyright & legal identification -->
    <div class="pt-8 mt-8 border-t border-gray-800 text-center text-gray-400 text-sm">
      <p>&copy; {currentYear} {site.legalName}. All rights reserved.</p>
      <p class="mt-1">IČO: {site.ico} &middot; {fullAddress} (office address, not a meeting point)</p>
      <p class="mt-2">
        <a href="/privacy-policy/" class="hover:text-primary-300 mr-4">Privacy Policy</a>
        <a href="/terms-of-service/" class="hover:text-primary-300">Terms of Service</a>
      </p>
    </div>
  </div>
</footer>
