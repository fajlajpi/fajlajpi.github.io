---
import Navigation from "./Navigation.astro";
import { site } from "../../config/site";
---

<header class="sticky top-0 z-50 w-full bg-white/90 backdrop-blur-md shadow-sm">
  <div class="container flex items-center justify-between h-20">
    <a href="/" class="text-xl sm:text-2xl font-bold text-primary-800 font-serif flex items-center">
      <img src="/uploads/bluefox.png" alt="" width="960" height="540" class="h-10 sm:h-12 w-auto mr-2">
      <span class="text-primary-800">{site.name}</span>
    </a>
    
    <Navigation />
  </div>
</header>